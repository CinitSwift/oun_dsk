{
  "name": "ouonnkitv",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "desktop/main.cjs",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm build:web",
    "build:web": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:electron": "wait-on http://127.0.0.1:3000 && cross-env OUN_DEV_SERVER_URL=http://127.0.0.1:3000 electron .",
    "desktop:dev": "concurrently -k \"pnpm dev\" \"pnpm desktop:electron\"",
    "desktop:build:mac": "pnpm build:web:desktop && electron-builder --publish never --mac dmg",
    "desktop:build:win": "pnpm build:web:desktop && electron-builder --publish never --win nsis",
    "build:web:desktop": "tsc -b && vite build --mode desktop",
    "build:android": "pnpm build:web && cap sync android && cd android && ./gradlew assembleDebug",
    "cap:sync": "cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@cloudflare/workers-types": "^4.20251128.0",
    "@eslint/js": "^9.25.0",
    "@heroui/react": "2.8.0-beta.7",
    "@hookform/resolvers": "^5.2.2",
    "@netlify/functions": "^5.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.1.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.11.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vercel/analytics": "^1.5.0",
    "@vercel/node": "^3.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "@vitejs/plugin-react": "^4.4.1",
    "artplayer": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "dayjs": "^1.11.13",
    "electron": "^37.2.6",
    "electron-builder": "25.1.8",
    "electron-builder-squirrel-windows": "25.1.8",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "framer-motion": "^12.16.0",
    "globals": "^16.0.0",
    "hls.js": "^1.6.15",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.556.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "react": "^19.1.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.68.0",
    "react-router": "^7.6.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.8",
    "tmdb-ts": "^2.0.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "uuid": "^11.1.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3",
    "zod": "^4.1.13",
    "zustand": "^5.0.5"
  },
  "build": {
    "appId": "com.cinitswift.oun",
    "productName": "Oun",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "proxy-server.js",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "desktop/assets/icon.icns"
    },
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
